# Copy to .env.local and fill in the values.

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/pj-hospital

# Secret used to sign session cookies (at least 32 random characters).
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# Claude API key for the AI intake assistant and case summaries.
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
